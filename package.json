{
  "name": "servigo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/scripts/backend-entry.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend": "node backend/scripts/backend-entry.mjs",
    "backend:ci": "node scripts/testing/run-backend-ci-if-available.mjs",
    "lint": "npm run lint:prod && npm run lint:legacy",
    "lint:prod": "eslint backend/config backend/controllers backend/middleware backend/models backend/routes backend/services backend/utils backend/validators src/client src/shared --ext .js,.jsx,.mjs --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:legacy": "node scripts/testing/run-legacy-lint-if-available.mjs",
    "typecheck": "node scripts/testing/run-typecheck-if-inputs.mjs",
    "test:concurrency-workflow": "node backend/scripts/run-concurrency-workflow.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests",
    "test:open-handles:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --passWithNoTests backend/tests/authFlow.test.js backend/tests/bookingFlow.test.js",
    "test:open-handles:smoke:force-exit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit --passWithNoTests backend/tests/authFlow.test.js backend/tests/bookingFlow.test.js",
    "test:a11y": "node scripts/testing/run-a11y-if-available.mjs",
    "test:a11y:smoke": "start-server-and-test \"npm run preview -- --host 127.0.0.1 --port 4173\" http://127.0.0.1:4173 \"node scripts/a11y/axe-audit-smoke.mjs\"",
    "test:frontend:qa": "node scripts/testing/run-playwright-with-services.mjs backend/tests/frontend.a11y.responsive.test.js --project=chromium",
    "test:frontend:a11y": "npm run test:frontend:qa",
    "test:frontend:a11y:ci": "npm run test:frontend:a11y",
    "test:frontend:responsive": "npm run test:frontend:qa",
    "test:frontend:responsive:ci": "npm run test:frontend:responsive",
    "test:frontend:smoke": "node scripts/testing/run-playwright-with-services.mjs backend/tests/frontend.smoke.flow.test.js --project=chromium",
    "test:frontend:smoke:ci": "npm run test:frontend:smoke",
    "test:frontend:qa:ci": "npm run test:frontend:qa",
    "test:lighthouse": "node scripts/testing/run-lighthouse-if-available.mjs",
    "test:api:newman": "node scripts/testing/run-newman-if-available.mjs",
    "monitoring:validate": "node scripts/testing/run-monitoring-validate-if-available.mjs",
    "verify:development": "start-server-and-test \"npm run preview -- --host 127.0.0.1 --port 4173\" http://127.0.0.1:4173 \"node backend/scripts/verify-environment.mjs --env development --frontend-url http://127.0.0.1:4173 --backend-url http://127.0.0.1:5005\"",
    "verify:staging": "node backend/scripts/verify-environment.mjs --env staging",
    "verify:production": "node backend/scripts/verify-environment.mjs --env production",
    "reconcile:wipay": "node backend/scripts/reconcile-wipay-payments.mjs",
    "optimize:images": "node scripts/performance/optimize-images.mjs",
    "dev:all": "concurrently \"npm run backend\" \"npm run dev\"",
    "db:migrate": "node backend/scripts/run-migrations.mjs",
    "db:seed:ci": "node backend/scripts/seed-ci-data.mjs",
    "migrate": "npm run db:migrate",
    "migrate:check": "npm run db:migrate"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.924.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@google-cloud/secret-manager": "^6.1.0",
    "@sentry/node": "^10.11.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "i18next": "^26.3.6",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-vault": "^0.10.4",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.16.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.4.0",
    "uuid": "^14.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express-rate-limit": "^6.7.0",
    "globals": "^15.15.0",
    "jest": "^29.0.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "node-mocks-http": "^1.11.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "start-server-and-test": "^3.0.11",
    "supertest": "^6.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "wait-on": "^9.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/backend/tests/**/*.test.js"
    ],
    "transform": {},
    "moduleNameMapper": {
      ".*/src/shared/services(\\.js)?$": "<rootDir>/src/shared/services.js"
    },
    "setupFiles": [
      "<rootDir>/backend/tests/jest.env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/backend/tests/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/backend/tests/api.test.js",
      "<rootDir>/backend/tests/frontend\\..*\\.test\\.js$",
      "<rootDir>/backend/tests/.*\\.spec\\.js$",
      "<rootDir>/backend/tests/.*\\.e2e\\.js$",
      "<rootDir>/backend/tests/playwright/.*",
      "<rootDir>/backend/tests/.*playwright.*"
    ],
    "globalTeardown": "<rootDir>/backend/tests/jest.teardown.js",
    "resolver": "<rootDir>/backend/tests/jest-resolver.cjs"
  }
}
