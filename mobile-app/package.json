{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "verify:dist": "npm run export:web && node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.html')){console.error('dist build FAILED: dist/index.html missing'); process.exit(1)} console.log('dist build OK: dist/index.html found')\"",
    "vercel:preview": "npm run export:web && npx -y vercel@latest deploy --cwd .",
    "vercel:prod": "npm run export:web && npx -y vercel@latest deploy --cwd . --prod",
    "build:android": "npx -y eas-cli build -p android --profile production",
    "build:ios": "npx -y eas-cli build -p ios --profile production",
    "build:all": "npx -y eas-cli build --platform all --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~54.0.34",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^3.37.0",
    "react-native-web": "~0.21.0"
  },
  "private": true
}
